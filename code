<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Grelik</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
/* Layout: one centered column. Language picker first, then a zigzag path of 1000 squares, quiz opens as a sheet. */
:root{
  --bg:#EDF1F8; --surface:#FFFFFF; --ink:#101828; --muted:#566178; --line:#D3DAE7;
  --accent:#F2491F; --accent-ink:#FFFFFF; --accent-deep:#B93211;
  --ok:#17894A; --ok-deep:#0F6A37; --ok-ink:#FFFFFF; --ok-soft:#DDF3E7;
  --bad:#D92D3A; --bad-soft:#FCE3E5; --code:#EEF1F7;
  --display:'Bricolage Grotesque','Trebuchet MS','Segoe UI',sans-serif;
  --body:'Figtree','Segoe UI',system-ui,-apple-system,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0B101B; --surface:#161D2D; --ink:#EDF1FA; --muted:#97A3BA; --line:#29344D;
  --accent:#FF7A59; --accent-ink:#1A0A04; --accent-deep:#C9502F;
  --ok:#3CCB7F; --ok-deep:#23975B; --ok-ink:#04180C; --ok-soft:#10301F;
  --bad:#FF6B75; --bad-soft:#3A1519; --code:#0F1524; color-scheme:dark;}}
:root[data-theme="dark"]{
  --bg:#0B101B; --surface:#161D2D; --ink:#EDF1FA; --muted:#97A3BA; --line:#29344D;
  --accent:#FF7A59; --accent-ink:#1A0A04; --accent-deep:#C9502F;
  --ok:#3CCB7F; --ok-deep:#23975B; --ok-ink:#04180C; --ok-soft:#10301F;
  --bad:#FF6B75; --bad-soft:#3A1519; --code:#0F1524; color-scheme:dark;}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 var(--body);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);min-height:100vh}
[hidden]{display:none!important}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.wrap{max-width:720px;margin:0 auto}

/* ---------- picker ---------- */
#pick{padding-block:28px 56px}
.brand{font:800 15px/1 var(--display);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin:0 0 14px}
#pick h1{font:800 clamp(28px,6.4vw,44px)/1.08 var(--display);margin:0 0 10px;text-wrap:balance;letter-spacing:-.01em}
#pick .sub{margin:0 0 26px;color:var(--muted);max-width:52ch}
.langs{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.lang{width:100%;text-align:left;background:var(--surface);border:2px solid var(--line);border-bottom-width:5px;border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:2px;min-width:0}
.lang:hover{border-color:var(--accent)}
.lang:active{transform:translateY(2px);border-bottom-width:3px}
.lang b{font:700 16px/1.2 var(--display);overflow-wrap:anywhere}
.lang span{font:500 12px/1.3 var(--mono);color:var(--muted)}

/* ---------- path ---------- */
#path{padding-bottom:80px}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;background:var(--bg);border-bottom:2px solid var(--line)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:6}
.who{min-width:0}
.who b{display:block;font:800 22px/1.1 var(--display);overflow-wrap:anywhere}
.who small{color:var(--muted);font-weight:600}
.gear{flex:none;width:46px;height:46px;border-radius:14px;border:2px solid var(--line);border-bottom-width:5px;background:var(--surface);display:grid;place-items:center}
.gear svg{width:24px;height:24px;stroke:var(--ink)}
.menu{position:absolute;right:0;top:calc(100% + 8px);background:var(--surface);border:2px solid var(--line);border-radius:14px;padding:8px;min-width:210px;box-shadow:0 10px 30px rgba(0,0,0,.18)}
.menu button{width:100%;text-align:left;border:0;background:none;padding:12px 12px;border-radius:10px;font-weight:700}
.menu button:hover{background:var(--code)}
.bar .mwrap{position:relative}
#levels{display:flex;flex-direction:column;align-items:center;gap:26px;padding-top:34px}
.lv{display:flex;flex-direction:column;align-items:center;transform:translateX(var(--x));scroll-margin-top:120px}
.sq{width:96px;height:96px;border-radius:24px;border:0;background:var(--accent);color:var(--accent-ink);box-shadow:0 7px 0 var(--accent-deep);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;transition:transform .08s,box-shadow .08s}
.sq:active:not(:disabled){transform:translateY(5px);box-shadow:0 2px 0 var(--accent-deep)}
.sq .num{font:800 32px/1 var(--display);font-variant-numeric:tabular-nums}
.sq.done{background:var(--ok);color:var(--ok-ink);box-shadow:0 7px 0 var(--ok-deep);cursor:default}
.sq .ct{font:800 13px/1 var(--display);letter-spacing:.02em}
.sq .sc{font:700 12px/1 var(--mono);opacity:.9}
.bubble{display:flex;gap:8px;margin-bottom:16px;background:var(--surface);border:2px solid var(--line);border-radius:16px;padding:8px;position:relative}
.bubble::after{content:"";position:absolute;left:50%;bottom:-9px;width:14px;height:14px;background:var(--surface);border-right:2px solid var(--line);border-bottom:2px solid var(--line);transform:translateX(-50%) rotate(45deg)}
.b{border:0;border-radius:11px;padding:11px 22px;font:800 15px/1 var(--display);letter-spacing:.03em;text-transform:uppercase;min-width:92px}
.b.go{background:var(--accent);color:var(--accent-ink)}
.b.skip{background:var(--code);color:var(--ink)}

/* ---------- quiz sheet ---------- */
.overlay{position:fixed;inset:0;z-index:20;background:rgba(8,12,22,.62);display:flex;align-items:flex-end;justify-content:center;
  padding-left:env(safe-area-inset-left,0px);padding-right:env(safe-area-inset-right,0px)}
.sheet{background:var(--bg);width:100%;max-width:680px;max-height:100%;height:min(100%,760px);border-radius:26px 26px 0 0;display:flex;flex-direction:column;overflow:hidden;animation:rise .22s ease-out;
  padding-bottom:env(safe-area-inset-bottom,0px)}
@media (min-width:720px){.overlay{align-items:center;padding:24px}.sheet{border-radius:26px;height:min(100%,720px)}}
@keyframes rise{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}
.qtop{display:flex;align-items:center;gap:14px;padding:16px 18px 6px}
.x{flex:none;width:40px;height:40px;border-radius:12px;border:2px solid var(--line);background:var(--surface);display:grid;place-items:center;font-size:20px;line-height:1}
.segs{flex:1;display:grid;grid-template-columns:repeat(10,1fr);gap:4px}
.segs i{height:10px;border-radius:6px;background:var(--line)}
.segs i.ok{background:var(--ok)} .segs i.no{background:var(--bad)} .segs i.cur{background:var(--accent)}
.qmeta{padding:4px 20px 0;font:700 12px/1.3 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.qbody{flex:1;overflow-y:auto;padding:14px 20px 20px;display:flex;flex-direction:column;gap:16px}
.qtext{font:800 clamp(20px,4.6vw,26px)/1.25 var(--display);white-space:pre-line;overflow-wrap:anywhere;margin:0}
.opts{display:grid;gap:10px}
.opt{width:100%;text-align:left;background:var(--surface);border:2px solid var(--line);border-bottom-width:5px;border-radius:14px;padding:14px 16px;font:600 16px/1.35 var(--body);overflow-wrap:anywhere;white-space:pre-wrap}
.opt.code{font-family:var(--mono);font-size:14px;font-weight:500}
.opt:hover:not(:disabled){border-color:var(--accent)}
.opt:disabled{cursor:default}
.opt.right{border-color:var(--ok);background:var(--ok-soft)}
.opt.wrong{border-color:var(--bad);background:var(--bad-soft)}
.tf{grid-template-columns:1fr 1fr}
.tf .opt{text-align:center;font:800 20px/1 var(--display);padding:22px 12px}
textarea{width:100%;min-height:128px;resize:vertical;font:500 15px/1.5 var(--mono);background:var(--code);color:var(--ink);border:2px solid var(--line);border-radius:14px;padding:14px;tab-size:2}
textarea:focus{outline:none;border-color:var(--accent)}
.fb{border-radius:16px;padding:14px 16px;display:flex;flex-direction:column;gap:8px}
.fb.ok{background:var(--ok-soft);border:2px solid var(--ok)}
.fb.no{background:var(--bad-soft);border:2px solid var(--bad)}
.fb h3{margin:0;font:800 18px/1.2 var(--display)}
.fb p{margin:0}
.fb small{font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
pre{margin:0;background:var(--code);border-radius:10px;padding:10px 12px;font:500 14px/1.5 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere;color:var(--ink)}
.qfoot{padding:12px 20px 18px;border-top:2px solid var(--line);display:flex}
.cta{flex:1;border:0;border-radius:14px;padding:16px;font:800 16px/1 var(--display);letter-spacing:.04em;text-transform:uppercase;background:var(--accent);color:var(--accent-ink);box-shadow:0 5px 0 var(--accent-deep)}
.cta:active{transform:translateY(3px);box-shadow:0 2px 0 var(--accent-deep)}
.cta.ghost{background:var(--surface);color:var(--ink);box-shadow:0 5px 0 var(--line);border:2px solid var(--line)}
.cta.green{background:var(--ok);color:var(--ok-ink);box-shadow:0 5px 0 var(--ok-deep)}
.qfoot .row{display:flex;gap:10px;width:100%}
.res{display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;padding:26px 0}
.res .big{font:800 72px/1 var(--display);font-variant-numeric:tabular-nums}
.res h2{margin:0;font:800 26px/1.15 var(--display)}
.res p{margin:0;color:var(--muted);max-width:34ch}
.lesson{display:flex;flex-direction:column;gap:14px}
.lesson h2{margin:0;font:800 clamp(24px,5.4vw,32px)/1.12 var(--display);text-wrap:balance}
.lesson p{margin:0;font-size:17px;line-height:1.6}
.lcode{margin:0;border-left:5px solid var(--accent);border-radius:6px 14px 14px 6px;padding:14px 16px;font:500 15px/1.6 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere;background:var(--code)}
.llab{font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:4px 0 -6px}
.parts{display:grid;gap:8px;margin:0;padding:0;list-style:none}
.parts li{display:grid;grid-template-columns:minmax(0,max-content) minmax(0,1fr);gap:6px 14px;align-items:start;background:var(--surface);border:2px solid var(--line);border-radius:14px;padding:10px 12px}
.parts code{font:700 14px/1.4 var(--mono);background:var(--code);color:var(--ink);border-radius:8px;padding:4px 8px;overflow-wrap:anywhere;max-width:min(46vw,260px)}
.parts span{font-size:15.5px;line-height:1.5;min-width:0}
@media (max-width:430px){.parts li{grid-template-columns:1fr}.parts code{max-width:100%}}
.lout{background:var(--ok-soft);border:2px solid var(--ok);border-radius:14px;padding:12px 14px}
.lout small{display:block;font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.lout pre{background:transparent;padding:0;font-size:15px}
.ltip{display:flex;gap:10px;background:var(--surface);border:2px dashed var(--accent);border-radius:14px;padding:12px 14px;font-size:15.5px;line-height:1.5}
.ltip b{color:var(--accent);font:800 13px/1.6 var(--mono);letter-spacing:.06em;text-transform:uppercase;flex:none}
.tipq{font-size:14px;color:var(--muted);margin:-6px 0 0}
.review{display:flex;flex-direction:column;gap:12px}
.rv{border:2px solid var(--line);border-radius:14px;padding:12px 14px;background:var(--surface);display:flex;flex-direction:column;gap:8px}
.rv.ok{border-color:var(--ok)}.rv.no{border-color:var(--bad)}
.rvh{display:flex;justify-content:space-between;gap:10px;font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase}
.rvn{color:var(--muted)}.rv.ok .rvs{color:var(--ok)}.rv.no .rvs{color:var(--bad)}
.rvq{margin:0;font:700 16px/1.4 var(--body);white-space:pre-line;overflow-wrap:anywhere}
.rvl{font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-top:2px}
.rva{margin:0;background:var(--code);border-radius:10px;padding:9px 11px;font:500 14px/1.5 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}
.rv.no .rva{background:var(--bad-soft)}.rv .rva.good{background:var(--ok-soft)}
.qfoot .row.tri .cta{padding:16px 6px;font-size:14px;letter-spacing:.02em;min-width:0}
.menu button + button{margin-top:2px}
#bgimg{position:fixed;inset:0;z-index:-1;display:none;background-size:cover;background-position:center;background-repeat:no-repeat}
#bgimg::after{content:"";position:absolute;inset:0;background:var(--bg);opacity:.58}
body.hasbg #bgimg{display:block}
body.hasbg .bar{background:color-mix(in srgb,var(--bg) 78%,transparent);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
body.hasbg #pick .hd{background:color-mix(in srgb,var(--surface) 84%,transparent);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-radius:20px;padding:20px 22px;margin-bottom:22px}
#pick .hd{margin-bottom:0}
body.hasbg #pick .hd .sub{margin-bottom:0}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:40;background:var(--ink);color:var(--bg);padding:12px 18px;border-radius:14px;font:700 15px/1.3 var(--body);max-width:min(92vw,420px);text-align:center;box-shadow:0 8px 24px rgba(0,0,0,.3)}
.pop{animation:pop .3s ease-out}
@keyframes pop{0%{transform:scale(.97)}50%{transform:scale(1.02)}100%{transform:scale(1)}}
.padsheet{height:min(100%,780px)}
.padtitle{flex:1;font:800 20px/1.2 var(--display);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.padbody{flex:1;overflow-y:auto;padding:12px 20px 20px;display:flex;flex-direction:column;gap:14px}
.padhint{margin:0;color:var(--muted);font-size:15.5px}
.plist{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.pitem{display:flex;gap:8px;align-items:stretch}
.popen{flex:1;min-width:0;text-align:left;background:var(--surface);border:2px solid var(--line);border-bottom-width:5px;border-radius:14px;padding:12px 14px;display:flex;flex-direction:column;gap:2px}
.popen:hover{border-color:var(--accent)}
.popen b{font:800 17px/1.25 var(--display);overflow-wrap:anywhere}
.popen span{font:500 12px/1.4 var(--mono);color:var(--muted)}
.pdel{flex:none;border:2px solid var(--line);background:var(--surface);border-radius:14px;padding:0 14px;font:800 13px/1 var(--display);letter-spacing:.03em;text-transform:uppercase}
.pdel.sure{background:var(--bad);border-color:var(--bad);color:#fff}
.pform{display:flex;flex-direction:column;gap:10px;background:var(--surface);border:2px solid var(--line);border-radius:16px;padding:14px}
.pform label{font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.pform input,.pform select,.pname{width:100%;font:600 16px/1.3 var(--body);background:var(--code);color:var(--ink);border:2px solid var(--line);border-radius:12px;padding:12px 14px}
.pform input:focus,.pform select:focus,.pname:focus{outline:none;border-color:var(--accent)}
.perr{color:var(--bad);font-weight:700;margin:0;font-size:14.5px}
.pbar{display:flex;gap:8px;align-items:center}
.pbar .pname{flex:1;min-width:0;font-weight:800;font-family:var(--display);font-size:17px}
.plang{flex:none;font:700 12px/1 var(--mono);background:var(--code);border-radius:10px;padding:10px 10px;color:var(--muted)}
.ed{display:flex;border:2px solid var(--line);border-radius:14px;background:var(--code);overflow:hidden;min-height:260px;flex:1}
.gut{flex:none;margin:0;padding:14px 8px 14px 10px;background:transparent;color:var(--muted);font:500 14px/21px var(--mono);text-align:right;overflow:hidden;user-select:none;white-space:pre;border-radius:0;min-width:38px}
.ed textarea{flex:1;border:0;border-radius:0;min-height:0;resize:none;background:transparent;font:500 14px/21px var(--mono);padding:14px 12px 14px 6px;white-space:pre;overflow:auto;overflow-wrap:normal}
.ed textarea:focus{outline:none}
.ed:focus-within{border-color:var(--accent)}
.runov{z-index:30;align-items:center;padding:16px}
.runbox{background:var(--bg);width:100%;max-width:560px;max-height:100%;overflow-y:auto;border-radius:22px;padding:16px 18px 18px;display:flex;flex-direction:column;gap:12px;animation:rise .22s ease-out}
.runbox h2{margin:0;font:800 20px/1.2 var(--display)}
.rcmd{font:600 13px/1.4 var(--mono);background:var(--code);border-radius:10px;padding:9px 11px;overflow-wrap:anywhere}
.rcmd i{font-style:normal;color:var(--muted)}
.pc{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.pcb{border:2px solid var(--line);background:var(--surface);border-radius:12px;padding:10px 4px 8px;text-align:center;font:800 12px/1.2 var(--display);transition:background .15s,border-color .15s,transform .15s}
.pcb svg{display:block;margin:0 auto 4px;width:26px;height:26px;stroke:var(--ink);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.pcb small{display:block;font:500 10px/1.2 var(--mono);color:var(--muted);margin-top:2px}
.pcb.on{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 14%,var(--surface));transform:translateY(-2px)}
.rsteps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.rsteps li{display:flex;gap:10px;background:var(--surface);border:2px solid var(--line);border-radius:12px;padding:8px 10px;font-size:15px;line-height:1.4;animation:pop .3s ease-out}
.rsteps li b{flex:none;font:700 11px/1.8 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--accent);min-width:58px}
.rsteps li.cur{border-color:var(--accent)}
.rscreen{background:#0d1117;color:#d7f7df;border-radius:12px;padding:10px 12px;font:500 14px/1.5 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere;min-height:48px}
.rscreen small{display:block;font:700 10px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#7d8a9c;margin-bottom:6px}
.rscreen.page{background:#fff;color:#111;font-family:var(--body)}
.rmem{width:100%;border-collapse:collapse;font:500 13px/1.4 var(--mono)}
.rmem th,.rmem td{border:2px solid var(--line);padding:5px 8px;text-align:left}
.rmem th{background:var(--code);font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.rsum{background:var(--ok-soft);border:2px solid var(--ok);border-radius:12px;padding:10px 12px;font-size:15px}
.rsum b{display:block;font:800 13px/1.3 var(--display);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.rsum ul{margin:0;padding-left:18px}
.rwarn{background:var(--surface);border:2px dashed var(--accent);border-radius:12px;padding:10px 12px;font-size:14.5px}
.rwarn b{color:var(--accent)}
.rnote{margin:0;color:var(--muted);font-size:13.5px}
.rrow{display:flex;gap:10px}
.rrow .cta{padding:14px 8px;font-size:14px}
.runbox>*{flex-shrink:0}

.stg{width:100%;text-align:center;background:var(--surface);border:2px solid var(--line);border-radius:18px;padding:14px 16px;margin:10px 0 4px}
.stg b{display:block;font:800 20px/1.2 var(--display)}
.stg span{display:block;font:700 12px/1.4 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--accent);margin-top:2px}
.stg p{margin:6px 0 0;color:var(--muted);font-size:15px}
.lstage{background:var(--surface);border:2px solid var(--accent);border-radius:14px;padding:12px 14px}
.lstage small{display:block;font:700 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-bottom:6px}
.lstage p{margin:0;font-size:15.5px}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="bgimg" aria-hidden="true"></div>
<input type="file" id="bgfile" accept="image/*" hidden>
<div id="toast" role="status" hidden></div>

<section id="pick" hidden>
  <div class="wrap">
    <div class="hd">
