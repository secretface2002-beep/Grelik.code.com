    if(res.out.length)add('screen',k==='browser'?'The page is drawn in the browser window.':k==='query'?'The answer comes back as a result table.':'The words appear on the screen.');
    else add('screen',k==='browser'?'The page is drawn, but this preview found nothing to show.':'The program printed nothing, so the screen stays empty.');
    add('disk','Finished. '+(k==='interp'||k==='browser'||k==='query'?'Your file on the disk did not change.':'“'+bin+'” stays on the disk, so you can run it again without translating.')+(res.vars.length?' The variables in memory are cleared.':''));
