      it.opts.forEach(function(t,k){var b=el('button','opt'+(codey?' code':''),t);b.type='button';b.addEventListener('click',function(){grade(it,k,g2);});g2.appendChild(b);});
      body.appendChild(g2);
    }else{
      var ta=el('textarea');ta.id='ans';ta.rows=it.lines.length>1?5:3;ta.spellcheck=false;ta.autocapitalize='off';ta.autocomplete='off';ta.setAttribute('autocorrect','off');
