    else if(k==='vm'){add('cpu',tool.charAt(0).toUpperCase()+tool.slice(1)+' translates your file into bytecode, a small in-between language.');add('disk','The bytecode is saved as a new file on the disk.');add('mem','Then '+info.vm+' starts up in memory and loads the bytecode.');add('cpu','The virtual machine turns the bytecode into processor instructions as it goes, one line at a time.');}
    else if(k==='transpile'){add('cpu',tool.charAt(0).toUpperCase()+tool.slice(1)+' translates your '+L.n+' into plain JavaScript.');add('disk','A new JavaScript file is saved on the disk next to yours.');add('mem',info.vm.charAt(0).toUpperCase()+info.vm.slice(1)+' loads that JavaScript file into memory.');add('cpu','The JavaScript runs, one line at a time.');}
    else if(k==='browser'){add('mem',info.tool.charAt(0).toUpperCase()+info.tool.slice(1)+' reads the text and builds a tree of page parts in memory.');add('cpu','The processor works out the size, colour and position of every part.');}
    else{add('mem','The database engine starts and loads the tables it needs into memory.');add('cpu','It reads your query, finds the matching data and works out the answer.');}
    var shown=0,more=0;
    res.lines.forEach(function(ln){
      if(ln.t==='blank')return;if(k==='browser'&&ln.t==='unknown')return;
      if(shown>=10){more++;return;}shown++;
      var p='Line '+ln.no+': ';
      if(ln.t==='comment')add('cpu',p+'a comment. It is a note for people, so the computer skips it.');
