    else{b.style.backgroundImage='';document.body.classList.remove('hasbg');$('#bgreset').hidden=true;}
  }
  function closeMenu(){$('#menu').hidden=true;$('#gear').setAttribute('aria-expanded','false');}
  $('#bgbtn').addEventListener('click',function(){closeMenu();$('#bgfile').value='';$('#bgfile').click();});
  $('#bgreset').addEventListener('click',function(){closeMenu();applyBg(null);try{localStorage.removeItem(BGK);}catch(e){}toast('Background removed.');});
  $('#bgfile').addEventListener('change',function(){
    var f=this.files&&this.files[0];if(!f)return;
    if(f.type&&f.type.indexOf('image/')!==0){toast('Please choose a photo (JPG, PNG, WebP or GIF).');return;}
    var u=URL.createObjectURL(f),img=new Image();
    img.onload=function(){
      var max=1600,w=img.naturalWidth,h=img.naturalHeight,k=Math.min(1,max/Math.max(w,h)),url=null;
      try{
        var c=document.createElement('canvas');c.width=Math.max(1,Math.round(w*k));c.height=Math.max(1,Math.round(h*k));
        var x=c.getContext('2d');x.fillStyle='#ffffff';x.fillRect(0,0,c.width,c.height);x.drawImage(img,0,0,c.width,c.height);
        url=c.toDataURL('image/jpeg',0.82);
