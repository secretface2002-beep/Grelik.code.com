  /* ---------- sound effects (synthesised, no files) ---------- */
  var SFXK='grelik:sfx',sfxOn=store.get(SFXK)!=='0',actx=null;
  function ac(){
    if(actx)return actx;
    try{var C=window.AudioContext||window.webkitAudioContext;if(C)actx=new C();}catch(e){actx=null;}
    return actx;
  }
  var SFX={
    tap:[[620,.04,'triangle',.05]],
    start:[[440,.07,'triangle',.08],[660,.07,'triangle',.08],[880,.12,'triangle',.08]],
    correct:[[660,.08,'sine',.1],[990,.16,'sine',.1]],
    wrong:[[240,.12,'square',.05],[170,.22,'square',.05]],
    win:[[523,.1,'triangle',.1],[659,.1,'triangle',.1],[784,.1,'triangle',.1],[1047,.3,'triangle',.1]],
    lose:[[392,.12,'triangle',.08],[330,.12,'triangle',.08],[262,.25,'triangle',.08]],
    done:[[523,.08,'sine',.1],[784,.08,'sine',.1],[1047,.2,'sine',.1]],
    skip:[[360,.07,'triangle',.07],[270,.12,'triangle',.07]],
    tick:[[880,.05,'sine',.06]],
    run:[[330,.08,'sawtooth',.04],[495,.08,'sawtooth',.04],[660,.14,'sawtooth',.04]]
  };
  function sfx(name){
    if(!sfxOn)return;var c=ac(),seq=SFX[name];if(!c||!seq)return;
    try{
      if(c.state==='suspended')c.resume();
      var t=c.currentTime+0.005;
      seq.forEach(function(n){
        var o=c.createOscillator(),g=c.createGain();
        o.type=n[2];o.frequency.value=n[0];
        g.gain.setValueAtTime(0.0001,t);g.gain.exponentialRampToValueAtTime(n[3],t+0.01);g.gain.exponentialRampToValueAtTime(0.0001,t+n[1]);
        o.connect(g);g.connect(c.destination);o.start(t);o.stop(t+n[1]+0.02);t+=n[1]*0.9;
      });
