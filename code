  if(t==='mc')return mkMC(L,p[1],r);
  if(t==='bank')return bankQuiz(r,p[1],DIFF);
  if(p[1]==='basic')return bankQuiz(r,'basic',DIFF);
  q=GENS[p[1]](r,DIFF);
  if(q.a===-1)q.a=q.opts.indexOf(q._ans);
  return q;
}
function genLevel(L,level,attempt){
  var r=rng(hashStr(L.n+'#'+level+'#'+(attempt||0)));
  DIFF=diffOf(level);
  var ft=topicOf(level),plan=PLAN[ft.topic].slice();
  if(ft.review){
    var pool=[];learnedTopics(level).forEach(function(tp){PLAN[tp].forEach(function(s){if(/^(g|bank):/.test(s)&&s!=='g:basic')pool.push(s);});});
    if(pool.length){plan[8]=pick(r,pool);plan[9]=pick(r,pool);}
  }
  var tp=textPool(DIFF),tx={i:0,j:0,list:shuffle(r,tp),names:shuffle(r,NAMES),
    next:function(){var x=this.list[this.i%this.list.length];this.i++;return x;},
    name:function(){var x=this.names[this.j%this.names.length];this.j++;return x;}};
  var ctx={wi:0,wl:wlines(level)},seen={},out=[];
  plan.forEach(function(spec){
    var q;
    for(var i=0;i<14;i++){q=buildSpec(L,spec,r,tx,ctx);if(!seen[q.q])break;if(spec.charAt(0)==='w')ctx.wi--;}
    seen[q.q]=1;out.push(q);
  });
  return shuffle(r,out);
}
/* ===== lessons: beginner topics first, then advanced topics as the levels climb ===== */
var LEVELUP=[
  'Say the code out loud in plain words. If you can explain a line, you understand it.',
  'Change one small thing in an example, then predict what will happen. That is how programmers learn.',
  'Mistakes are normal. Every programmer sees error messages every day.',
  'Type the code yourself instead of copying it. Your fingers learn the pattern.',
  'Short practice every day beats one long session once a week.',
  'When code surprises you, slow down and read it one line at a time, top to bottom.',
  'Good names make code easy to read. Pick names that say what the value is.',
  'Take a break when you are stuck. Many bugs look obvious after a rest.'
];
function lessonBody(L,topic,level,review){
  var r=rng(hashStr(L.n+'@lesson#'+level));
  var tl=shuffle(r,TEXTS),t1=tl[0],t2=tl[1],nl=shuffle(r,NAMES),n1=nl[0],n2=nl[1];
  var v1=ri(r,2,99),v2=ri(r,2,99),title='',b=[];
  function P(x){b.push({k:'p',t:x});}
  function C(code,lab){b.push({k:'code',t:code,l:lab||''});}
  function PT(p){b.push({k:'parts',t:p});}
  function OUT(x,lab){b.push({k:'out',t:x,l:lab||'What you will see'});}
  function TIP(x){b.push({k:'tip',t:x});}
  var pre=review?'Review: ':'';
  var note={'HTML':'HTML is a markup language. Instead of giving step-by-step commands, it describes what a web page contains.','CSS':'CSS is a style language. It describes how a web page looks: colors, sizes and spacing. It works together with HTML.','SQL':'SQL is a query language. You use it to ask a database questions, and the database answers.'}[L.n];
  var IDEA='The idea (each language spells it a little differently)';

  if(topic==='meet'){
    if(!review){
      title='Meet '+L.n;
      P('Welcome! Coding means writing instructions for a computer. The instructions are written in a programming language, and you are about to learn one called '+L.n+'.');
      P(L.n+' first appeared in '+L.y+'. It was created by '+L.by+'. People mostly use it for '+L.use+'.');
      if(note)P(note);
      P('Files you write in '+L.n+' usually end in '+L.ex+'. The ending tells the computer which language is inside.');
      P('A program is a list of instructions. The computer follows them from the top line to the bottom line, one at a time. Here is the classic first program. It shows the words “Hello, World!” on the screen:');
      C(sayText(L,'Hello, World!'));PT(explainSay(L,'Hello, World!'));
      TIP('You do not need to memorize anything yet. Read the lesson, then try the quizzes. You will see everything again and again. In a full program, some languages need a little extra setup around this line. Here we focus on the line itself.');
    }else{
      title=pre+'A fact about '+L.n;
      var facts=[L.n+' first appeared in '+L.y+'.',L.n+' was created by '+L.by+'.',L.n+' is mostly used for '+L.use+'.','Files written in '+L.n+' usually end in '+L.ex+'.'];
      P(facts[level%facts.length]);if(note)P(note);
      P('Here is a line of '+L.n+' that shows some text:');C(sayText(L,t1));PT(explainSay(L,t1));
    }
  }else if(topic==='print'){
    title=pre+'Showing text on the screen';
    P('The most common first job for a program is to show a message. This is called printing, even though nothing goes onto paper. In '+L.n+' it looks like this:');
    C(sayText(L,t1));PT(explainSay(L,t1));OUT(t1);
    P('Look for the pattern: the command first, then the text inside quote marks. Change the words between the quotes and the message on the screen changes too.');
    TIP('Text always needs quote marks. Without them, '+L.n+' thinks your words are commands and shows an error.');
  }else if(topic==='print2'){
    title=pre+'Two lines, one after another';
    P('A program runs from the top line to the bottom line, one instruction at a time. Here are two instructions:');
    C(sayText(L,t1)+'\n'+sayText(L,t2));
    PT([['Line 1','Runs first. It shows “'+t1+'”.'],['Line 2','Runs second. It shows “'+t2+'”.']]);
    OUT(t1+'\n'+t2);P(endMarkText(L));
    TIP('Order matters. If you swap the two lines, the messages appear in the opposite order.');
  }else if(topic==='comment'){
    title=pre+'Notes for humans: comments';
    P('A comment is a note you leave inside your code. The computer skips it completely. Comments explain what the code is for, to you and to other people. In '+L.n+', a comment looks like this:');
    C(fillTpl(L.cm[0],{t:t1}));PT(symbolParts(L,t1));
    P('Here a comment sits above a real instruction. Only the second line does anything:');
    C(fillTpl(L.cm[0],{t:t1})+'\n'+sayText(L,t2));OUT(t2);
    TIP('A good comment explains why the code does something, not just what it does.');
  }else if(topic==='variable'){
    if(L.vr){
      title=pre+'Variables: boxes with names';
      P('A variable is a labeled box where a program keeps a value, such as a number or some text. You choose the name. Later, the program can look inside the box whenever it needs the value. In '+L.n+':');
      C(varText(L,n1,v1));PT(explainVar(L,n1,v1));
      P('This stores '+v1+' in a box called '+nameFor(L,n1)+'. Later lines can use that name to get the '+v1+' back. Here is the same idea with a different name and value:');
      C(varText(L,n2,v2));
      TIP('Choose names that describe what is inside, like score or price. A name like x tells nobody anything.');
    }else{
      title=pre+'Attributes: extra information';
      P('HTML does not have variables like other languages do. Instead, a tag can carry extra information called an attribute.');
      C('<p class="note">'+t1+'</p>');
      PT([['<p','The opening tag: a paragraph starts.'],['class="note"','An attribute. The name is class and the value is note. It gives the paragraph a label that style rules can use.'],['>'+t1+'</p>','The words people see, then the closing tag.']]);
      TIP('Attribute values go inside quote marks, just like text in other languages.');
    }
  }else if(topic==='numbers'){
    var a=ri(r,3,9),bb=ri(r,2,6);
    title=pre+'Numbers and math';
    P('Computers are very good at math. Almost every language uses the same signs for it. These lines show the idea:');
    C(a+' + '+bb+'     gives '+(a+bb)+'\n'+(a+bb)+' - '+bb+'     gives '+a+'\n'+a+' * '+bb+'     gives '+(a*bb)+'\n'+(a*bb)+' / '+bb+'     gives '+a,'The idea (works in almost every language)');
    PT([['+','Add.'],['-','Subtract.'],['*','Multiply. The star is used because × is not on the keyboard.'],['/','Divide.'],['%','Remainder after dividing. 7 % 3 is 1, because 3 fits into 7 twice with 1 left over.']]);
    P('Order of operations works like in math class. Multiplication and division happen before addition and subtraction. So 2 + 3 * 4 is 14, not 20. Brackets go first: (2 + 3) * 4 is 20.');
    TIP('If you are not sure about the order, add brackets. They make your meaning clear to the computer and to people.');
  }else if(topic==='text'){
    title=pre+'Text, also called strings';
    P('A piece of text in code is called a string. It is a row of characters inside quote marks. Letters, digits, spaces and symbols all count as characters.');
    C('"Hello"            has 5 characters\n"Hi there"          has 8 characters\n"Hel" + "lo"        makes "Hello"','The idea (details differ by language)');
    PT([['"Hello"','A string. The quote marks are not part of the text.'],['5 characters','The length of a string is how many characters it holds. Spaces count.'],['+','In many languages, joining two strings together makes one longer string.']]);
    TIP('"7" in quotes is text, and 7 without quotes is a number. They behave differently.');
  }else if(topic==='truefalse'){
    var big=ri(r,6,20),small=ri(r,1,5);
    title=pre+'True or false: Booleans';
    P('Some questions have only two answers: yes or no. In code these answers are called Booleans, and they are written true and false. Programs use them to make decisions.');
    C(big+' > '+small+'          is true\n'+small+' > '+big+'          is false\n'+big+' == '+big+'        is true\ntrue AND false   is false\ntrue OR false    is true\nNOT true         is false','The idea (works in almost every language)');
    PT([['>','Greater than. It asks “is the left side bigger?”'],['==','Is equal to. Two equals signs ask a question. One equals sign would store a value.'],['AND','True only when both sides are true.'],['OR','True when at least one side is true.'],['NOT','Flips true to false and false to true.']]);
    TIP('Spelling changes between languages. Some use && for AND, || for OR and ! for NOT. The idea is identical.');
  }else if(topic==='ifs'){
    var th=ri(r,10,18),val=ri(r,5,24);
    title=pre+'Decisions: if and else';
    P('Programs can choose what to do. You ask a question, and the answer decides which instructions run. This idea is called a conditional.');
    C('age = '+val+'\nif age >= '+th+':\n    show "big"\nelse:\n    show "small"',IDEA);
    PT([['if age >= '+th,'The question, called the condition. If the answer is yes, the lines under it run.'],['show "big"','Runs only when the answer is yes.'],['else','Means “otherwise”. The lines under it run when the answer is no.']]);
    OUT('Because '+val+(val>=th?' is '+th+' or more':' is less than '+th)+', the program shows: '+(val>=th?'big':'small'));
    TIP('Every language uses the same idea: ask a question, then choose. Only the punctuation changes.');
  }else if(topic==='loop'){
    var nn=ri(r,3,6);
    title=pre+'Loops: repeat without retyping';
    P('A loop repeats instructions. Instead of writing the same line five times, you write it once and tell the computer how many times to repeat it. In '+L.n+', the start of a loop looks like this:');
    if(L.lp){C(fillTpl(L.lp,{n:nn}));PT(explainLoop(L,nn));}
    else P(L.n+' does not have a classic loop line like many languages do. It works in a different way, but the idea of repeating work is the same.');
    var rounds='';for(var i=1;i<=nn;i++)rounds+=(i>1?'\n':'')+'Round '+i;
    OUT(rounds,'If the loop repeats '+nn+' times');
    TIP('A loop that never ends is called an infinite loop. Always make sure the loop has a way to stop.');
  }else if(topic==='lists'){
    var la=ri(r,10,99),lb=ri(r,10,99),lc=ri(r,10,99);
    title=pre+'Lists: many values under one name';
    P('A list holds many values under one name. Each value has a position number called an index. Most languages start counting at 0, not 1.');
    C('items = ['+la+', '+lb+', '+lc+']\nitems[0]   is '+la+'\nitems[1]   is '+lb+'\nitems[2]   is '+lc,'The idea (square brackets are common)');
    PT([['[ ]','Square brackets hold the whole list.'],['items[0]','The first item. The number in brackets is the index.'],['3 values','The list has 3 values, but the last index is 2, because counting starts at 0.']]);
    TIP('Counting from 0 feels strange at first. Everyone gets used to it.');
  }else if(topic==='function'){
    var fx=ri(r,2,9);
    title=pre+'Functions: reusable recipes';
    P('A function is a named set of instructions that you can use again and again. It can take inputs and give back a result. Think of it as a recipe card: write it once, use it whenever you like.');
    C('function double(x):\n    return x * 2\n\ndouble('+fx+')   gives '+(fx*2),IDEA);
    PT([['function double(x)','Creates a function named double. The x is the input, called a parameter.'],['return x * 2','Sends the result back to whoever used the function.'],['double('+fx+')','Uses the function with the input '+fx+'. This is called a call.']]);
    P(L.fk?'In '+L.n+', the word that starts a function is “'+L.fk+'”.':L.n+' has its own way to write functions, with a name, inputs and a result. The idea is the same.');
    TIP('If you write the same steps twice, put them in a function instead.');
  }else if(topic==='bugs'){
    title=pre+'Bugs and error messages';
    P('A bug is a mistake in a program. Every programmer makes bugs every day. Finding and fixing them is called debugging. Here is a line with a bug. The closing quote mark is missing:');
    var okline=sayText(L,t1),broken=okline.replace(/["'](?=[^"']*$)/,'');
    C(broken,'Broken');
    P('The computer cannot understand this line, so it shows an error message instead of running the program. The message usually names the line with the problem. Here is the fixed line:');
    C(okline,'Fixed');
    PT([['Syntax error','The code broke the grammar rules, so the program will not start.'],['Runtime error','The program starts, then crashes, for example by dividing by zero.'],['Logic error','The program runs but gives the wrong answer. These are the hardest to spot.']]);
    TIP('Read the error message from the top. Fix one thing at a time and run the program again after each change.');
  }else if(topic==='binary'){
    var bn=ri(r,3,15);
    title=pre+'Binary: how computers count';
    P('Inside a computer, everything is stored using only two digits: 0 and 1. Each one is called a bit. Eight bits together make a byte. Binary is just counting with two digits instead of ten.');
    C('place values:   8  4  2  1\nbinary:         '+((bn>>3)&1)+'  '+((bn>>2)&1)+'  '+((bn>>1)&1)+'  '+(bn&1)+'\nadd up the places with a 1  =  '+bn,'Reading binary '+bn.toString(2));
    PT([['bit','One binary digit: a 0 or a 1.'],['place values','Each place is worth double the one to its right: 1, 2, 4, 8, 16 and so on.'],['byte','8 bits. Enough for 256 different values, from 0 to 255.']]);
    TIP('To read binary, add up the place values that have a 1 under them.');

  /* ----- advanced topics ----- */
  }else if(topic==='elseif'){
    var sc=ri(r,40,99);
    title=pre+'Else if: more than two choices';
    P('Sometimes two choices are not enough. Add else if to check more questions, one after another. The computer asks them from the top and stops at the first one that is true.');
    C('score = '+sc+'\nif score >= 90:\n    show "A"\nelse if score >= 70:\n    show "B"\nelse:\n    show "C"',IDEA);
    PT([['if score >= 90','The first question. If the answer is yes, the computer shows A and skips everything below.'],['else if score >= 70','Only asked when the first answer was no.'],['else','Runs when every question above was no.']]);
    OUT('score is '+sc+', so the program shows: '+(sc>=90?'A':sc>=70?'B':'C'));
    P('The spelling changes. Python writes elif, Ruby writes elsif, and C and JavaScript write else if. The idea is exactly the same.');
    TIP('Put the most specific question first. If you ask score >= 70 first, a score of 95 would stop there and never reach the A.');
  }else if(topic==='whileloop'){
    title=pre+'While loops: repeat until something changes';
    P('A for loop repeats a set number of times. A while loop keeps repeating as long as its condition stays true. Use it when you do not know in advance how many rounds you need.');
    C('x = 1\nwhile x < 50:\n    x = x * 2\nshow x',IDEA);
    PT([['while x < 50','The condition. It is checked before every round. If it is false, the loop ends.'],['x = x * 2','The body. It changes x, which moves the loop toward its end.'],['show x','Runs once, after the loop has finished.']]);
    OUT('x becomes 2, 4, 8, 16, 32, 64. Then 64 < 50 is false, so the loop stops and the program shows 64.');
    TIP('If nothing inside the loop changes the condition, the loop never ends. That is an infinite loop.');
  }else if(topic==='strings2'){
    title=pre+'Text: positions and pieces';
    P('Every character in a string has a position number, called an index. Counting starts at 0. The length of a string is how many characters it has.');
    C('text = "coding"\ntext[0]       is "c"\ntext[5]       is "g"\nlength(text)  is 6\nupper(text)   is "CODING"\ntext + "!"    is "coding!"','The idea (the exact spelling differs by language)');
    PT([['text[0]','The first character. The position goes inside square brackets in many languages.'],['length(text)','How many characters there are. The last index is always length minus 1.'],['upper(text)','A copy with every letter as a capital.'],['text + "!"','Joining two strings makes a longer string.']]);
    P('You can also take a piece of a string. Many languages let you give a start and an end position. The end is not included, so the first 3 characters of "coding" are "cod".');
    TIP('The last index is length minus 1. A string of 6 characters has indexes 0 to 5.');
  }else if(topic==='math2'){
    title=pre+'More math: division, remainders and powers';
    P('Dividing whole numbers gives two useful answers: how many whole times one number fits into another, and what is left over. The left-over part is called the remainder, and the sign for it is %.');
    C('17 // 5   is 3    (5 fits into 17 three whole times)\n17 % 5    is 2    (3 * 5 is 15, and 2 is left over)\n2 ** 3    is 8    (2 times 2 times 2)\n10 % 2    is 0    (10 is even)\n7 % 2     is 1    (7 is odd)','The idea (spellings vary a little)');
    PT([['//','Whole-number division. In C and Java, a plain / does this when both numbers are whole.'],['%','The remainder.'],['**','A power. Some languages write pow(2, 3) instead.']]);
    TIP('A number is even when n % 2 is 0. Programmers also use % to repeat things every 3rd or every 10th time.');
  }else if(topic==='dict'){
    title=pre+'Dictionaries: look things up by key';
    P('A list finds values by position. A dictionary finds values by name. Each entry is a pair: a key, which is the name you look up, and a value, which is what you get back.');
    C('ages = {"Ann": 12, "Bo": 9}\nages["Bo"]        is 9\nages["Di"] = 7    adds a new pair\nages["Bo"] = 10   changes Bo to 10','The idea (many languages use curly brackets)');
    PT([['{ }','Curly brackets hold the whole dictionary.'],['"Ann": 12','One pair. The key is "Ann" and the value is 12.'],['ages["Bo"]','Looks up the value for the key "Bo".']]);
    P('Keys are unique. If you store a value under a key that already exists, the old value is replaced. Some languages call dictionaries maps or hash tables.');
    TIP('Use a dictionary when you want to ask “what goes with this name?”');
  }else if(topic==='nested'){
    title=pre+'Loops inside loops';
    P('A loop can sit inside another loop. For every single round of the outer loop, the inner loop runs all of its rounds. This is how programs work with grids, tables and pairs.');
    C('for i from 1 to 3:\n    for j from 1 to 2:\n        show i, j',IDEA);
    PT([['for i from 1 to 3','The outer loop. It runs 3 times.'],['for j from 1 to 2','The inner loop. It runs 2 times for each round of the outer loop.'],['show i, j','Runs 3 * 2 = 6 times in total.']]);
    OUT('1 1\n1 2\n2 1\n2 2\n3 1\n3 2');
    TIP('Total rounds = outer rounds * inner rounds, unless the inner loop changes size with i.');
  }else if(topic==='listops'){
    title=pre+'Doing more with lists';
    P('Lists can grow, shrink and be reordered. Most languages have a command for each job. Watch the list change line by line:');
    C('items = [4, 8, 1]\nadd 6 to the end     items is [4, 8, 1, 6]\nremove the first     items is [8, 1, 6]\nsort the list        items is [1, 6, 8]\nsum of items is 15, biggest is 8, length is 3','The idea (each language names these differently)');
    PT([['add','Puts a new item at the end.'],['remove','Takes an item out. Later items move down by one position.'],['sort','Puts the items in order, from smallest to biggest.'],['length','How many items the list holds.']]);
    TIP('Sorting changes the list itself in many languages. Some give you a sorted copy instead.');
  }else if(topic==='fn2'){
    title=pre+'Functions with more than one input';
    P('A function can take several inputs, separated by commas. It can also keep its own private variables, which disappear when the function ends.');
    C('function area(w, h):\n    result = w * h\n    return result\n\narea(3, 4)   gives 12',IDEA);
    PT([['(w, h)','Two parameters. When you call area(3, 4), w is 3 and h is 4. The order matters.'],['result','A variable that lives only inside the function. Code outside cannot see it.'],['return result','Sends the answer back to the caller.']]);
    P('Printing and returning are different. Printing shows a value on the screen. Returning hands the value back to your code so you can use it in more math or store it.');
    TIP('Functions that return a value are easy to test: give an input, check the output.');
  }else if(topic==='recursion'){
    title=pre+'Recursion: a function that calls itself';
    P('A recursive function solves a problem by calling itself on a smaller version of the same problem. It must have a base case, which is the smallest problem it can answer directly. Without one, it never stops.');
    C('function fact(n):\n    if n <= 1:\n        return 1\n    return n * fact(n - 1)\n\nfact(4) = 4 * fact(3)\n        = 4 * 3 * fact(2)\n        = 4 * 3 * 2 * fact(1)\n        = 4 * 3 * 2 * 1 = 24',IDEA);
    PT([['if n <= 1','The base case. It stops the calls.'],['n * fact(n - 1)','The recursive case. The input gets smaller each time.'],['the call stack','Each waiting call is remembered until the one below it finishes.']]);
    TIP('Write the base case first. Then make sure every recursive call moves closer to it.');
  }else if(topic==='sorting'){
    title=pre+'Sorting and searching';
    P('Putting items in order is one of the oldest jobs in computing. Bubble sort is a simple way to see how it works: go from left to right, and whenever a number is bigger than the one on its right, swap them.');
    C('list = [5, 2, 8, 1]\ncompare 5 and 2: swap   ->  [2, 5, 8, 1]\ncompare 5 and 8: keep   ->  [2, 5, 8, 1]\ncompare 8 and 1: swap   ->  [2, 5, 1, 8]\nafter ONE pass: [2, 5, 1, 8]','Bubble sort, one pass');
    PT([['one pass','The biggest number moves all the way to the end.'],['many passes','Repeat until a pass makes no swaps.']]);
    P('Binary search finds an item in a sorted list by always checking the middle. Look for 20 in [2, 5, 9, 14, 20, 31, 40]: check 14, which is too small, so keep the right half. Check 31, which is too big, so keep the left part. Check 20, found in 3 checks. Each check throws away half of what is left.');
    TIP('Binary search only works when the list is already sorted.');
  }else if(topic==='bits'){
    title=pre+'Bits, hex and colours';
    P('Computers can work on the individual bits of a number. AND keeps the bits that are 1 in both numbers. OR keeps bits that are 1 in either. XOR keeps bits that are different.');
    C('12 = 1100\n10 = 1010\n12 AND 10 = 1000 = 8\n12 OR 10  = 1110 = 14\n12 XOR 10 = 0110 = 6\n5 shifted left by 2 = 20','Bit tricks');
    PT([['AND','1 only where both bits are 1.'],['OR','1 where either bit is 1.'],['XOR','1 where the bits differ.'],['shift left','Moves every bit left. Each step doubles the number.']]);
    P('Hexadecimal, or hex, counts with 16 digits: 0 to 9, then A to F. One hex digit is exactly 4 bits. Colours on web pages use it: #FF8000 means red FF (255), green 80 (128), blue 00 (0).');
    TIP('FF in hex is 255, the biggest number that fits in one byte.');
  }else if(topic==='bigo'){
    title=pre+'How fast is your code? Big-O';
    P('Programmers measure how the work of a program grows as its input grows. This is written with Big-O. It does not count seconds. It compares how fast the number of steps grows.');
    C('O(1)       one step, like reading the first item\nO(log n)   halving each time, like binary search\nO(n)       one pass through the list\nO(n²)      a loop inside a loop\nO(2ⁿ)      trying every combination','From fast to slow');
    PT([['O(1)','Constant. Does not grow with the input.'],['O(n)','Linear. Double the input, double the work.'],['O(n²)','Quadratic. Double the input, four times the work.']]);
    TIP('Big-O ignores small details. 3n and n are both O(n). What matters is the shape of the growth.');
  }else if(topic==='oop'){
    title=pre+'Objects and classes';
    P('A class is a blueprint. An object is a thing built from that blueprint. An object keeps its own data, called attributes, and has actions it can perform, called methods.');
    C('class Dog:\n    name\n    speak():\n        show name + " says woof"\n\nd = new Dog("Rex")\nd.speak()      shows: Rex says woof',IDEA);
    PT([['class Dog','The blueprint for every dog.'],['name','An attribute: data each dog keeps for itself.'],['speak()','A method: an action a dog can do.'],['new Dog("Rex")','Builds one object from the blueprint.']]);
    P('Inheritance lets a new class reuse an older one. Encapsulation means an object keeps its details inside and shows only what others need.');
    TIP('Ask: what things exist in my program, what do they know, and what can they do?');
  }else if(topic==='errors'){
    title=pre+'Handling errors safely';
    P('Some mistakes cannot be spotted before the program runs, such as a user typing letters where a number is needed. Many languages let you catch these problems and respond, instead of crashing.');
    C('try:\n    n = convert("abc") to a number\ncatch error:\n    show "That is not a number"\nfinally:\n    show "Done"',IDEA);
    PT([['try','Run this code, and watch for errors.'],['catch','Runs only if an error happened inside try.'],['finally','Runs every time, error or not.']]);
    P('Checking input before using it is called validation. When an error does crash a program, the message often shows a stack trace: the list of calls that led to the problem. Read it from the top.');
    TIP('Do not catch an error and then ignore it. Silent errors are the hardest to find.');
  }else if(topic==='stack'){
    title=pre+'Stacks, queues and other containers';
    P('Different jobs need different ways to store data. A stack is like a pile of plates: the last one you put on is the first one you take off. A queue is like a line at a shop: the first in line is served first.');
    C('stack: push 1, push 2, push 3, pop  ->  gives 3\nqueue: add 1, add 2, add 3, remove  ->  gives 1','Last in first out, and first in first out');
    PT([['stack','Last in, first out. Used for undo buttons and for tracking function calls.'],['queue','First in, first out. Used for print jobs and waiting lines.'],['set','Holds each value once, with no repeats.'],['tree','Items with children below them, like folders.'],['graph','Nodes joined by edges, like a map of roads.']]);
    TIP('Pick the container that matches how you will use the data.');
  }else if(topic==='algo'){
    title=pre+'Thinking like a problem solver';
    P('Good programmers do not start by typing. They understand the problem, write the steps in plain words, solve a tiny example by hand, then turn the steps into code and test them. The plain-word steps are called pseudocode.');
    C('biggest = first item of the list\nfor each item in the list:\n    if item > biggest:\n        biggest = item\nshow biggest','Finding the biggest number');
    PT([['biggest = first item','Start with a guess that is already in the list.'],['for each item','Look at every item once.'],['if item > biggest','Found a bigger one? Remember it.']]);
    P('Test with normal cases, and also with edge cases: an empty list, a list with one item, or very big numbers. Many bugs hide there.');
    TIP('Solve a small example by hand first. If you cannot do it by hand, you cannot code it yet.');
  }else if(topic==='types'){
    title=pre+'Types, memory and surprises';
    P('Every value has a type. Mixing types can give surprises. In many languages, adding the numbers 5 and 3 gives 8, but joining the texts "5" and "3" gives "53". Converting between them is called casting or parsing.');
    C('5 + 3          gives 8\n"5" + "3"      gives "53"\nparse("42")    gives the number 42\n0.1 + 0.2      gives 0.30000000000000004 in most languages','Surprises');
    PT([['static typing','Types are checked before the program runs.'],['dynamic typing','Types are checked while it runs.'],['floating point','Decimal numbers can have tiny rounding errors.'],['overflow','A number too big for its storage can wrap around.'],['null','A special value that means no value.']]);
    TIP('When a result looks strange, print the type of each value. It is often the clue.');
  }else if(topic==='concur'){
    title=pre+'Many things at once, and the network';
    P('Modern programs do many things at the same time: loading data, drawing the screen and listening for clicks. This is called concurrency. A thread is one path of work, and async code lets a program wait for slow tasks without freezing.');
    C('{"name": "Ann", "age": 12, "langs": ["Python", "Go"]}','JSON: a text format that programs use to share data');
    PT([['race condition','Two tasks change the same data, and the result depends on timing.'],['deadlock','Tasks wait on each other forever.'],['API','A set of rules for how programs talk to each other.'],['HTTP','How browsers and servers send requests and pages.'],['server','A computer that answers requests from other computers.']]);
    TIP('Shared data that many tasks can change is where the trickiest bugs live.');
  }else{
    title=pre+'Writing code others love to read';
    P('Working code is the start, not the finish. Great programmers write code that other people can read, test and change. Use clear names, keep functions small, and add comments for the why.');
    C('# hard to read\nd = p * q - r\n\n# easier to read\nprofit = price * quantity - cost','Before and after');
    PT([['clear names','profit tells a reader much more than d.'],['small functions','Each function does one job, so it is easy to test.'],['tests','Small checks that tell you when something breaks.'],['version control','Git saves every version, so you can go back.'],['code review','Another person reads your change and gives feedback.']]);
    TIP('The best way to improve now is to build small projects and read other people\'s code.');
  }
  if(review)TIP('Level-up tip: '+LEVELUP[(level*3)%LEVELUP.length]);
  return {topic:topic,title:title,blocks:b};
}
function genLesson(L,level){
  var ft=topicOf(level),les=lessonBody(L,ft.topic,level,ft.review),st=stageOf(level);
  if((level-1)%100===0)les.blocks.unshift({k:'stage',l:'Stage '+stageNo(level)+': '+st.name+' ('+st.diff+')',t:st.msg});
  les.review=ft.review;
  return les;
}

