    var ed=el('div','ed'),gut=el('pre','gut'),ta=el('textarea');ta.id='padcode';ta.value=p.code;ta.spellcheck=false;ta.autocapitalize='off';ta.autocomplete='off';ta.setAttribute('autocorrect','off');ta.setAttribute('aria-label','Your '+p.lang+' code');ta.wrap='off';
    function nums(){var n=Math.max(1,ta.value.split('\n').length),s='';for(var i=1;i<=n;i++)s+=i+(i<n?'\n':'');gut.textContent=s;gut.scrollTop=ta.scrollTop;}
    ta.addEventListener('input',function(){p.code=ta.value;p.t=Date.now();savePad();nums();});
    ta.addEventListener('scroll',function(){gut.scrollTop=ta.scrollTop;});
    ta.addEventListener('keydown',function(e){
      if(e.key==='Tab'){e.preventDefault();var s=ta.selectionStart;ta.value=ta.value.slice(0,s)+'  '+ta.value.slice(ta.selectionEnd);ta.selectionStart=ta.selectionEnd=s+2;ta.dispatchEvent(new Event('input'));}
      else if((e.ctrlKey||e.metaKey)&&e.key==='Enter'){e.preventDefault();runBtn.click();}
    });
    ed.appendChild(gut);ed.appendChild(ta);body.appendChild(ed);nums();
    body.appendChild(el('p','rnote','Saved automatically on this device. Tip: the Run preview understands show-text lines, comments and variables like the ones in the lessons.'));
    var row=el('div','row'),bk=el('button','cta ghost','Projects');bk.type='button';bk.addEventListener('click',function(){showList();});
    var runBtn=el('button','cta green','Run');runBtn.type='button';runBtn.id='padrunbtn';runBtn.dataset.ns='1';runBtn.addEventListener('click',function(){p.code=ta.value;savePad();runPreview();});
    row.appendChild(bk);row.appendChild(runBtn);foot.appendChild(row);
  }
  $('#padbtn').addEventListener('click',function(){closeMenu();openPad();});
  $('#padx').addEventListener('click',closePad);
  $('#padrun').addEventListener('click',function(e){if(e.target===this)closeRun();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){if(!$('#padrun').hidden)closeRun();else if(!$('#pad').hidden)closePad();}});

  /* ---------- start ---------- */
  var saved=store.get('grelik:lang'),L0=null;
  if(saved){LANGS.forEach(function(L){if(L.n===saved)L0=L;});}
  if(L0)openPath(L0);else{$('#pick').hidden=false;}
})();
</script>
</body>
