function mc(r,q,correct,wrongs,ordered){
  var seen={};seen[correct]=1;var w=[];
  wrongs.forEach(function(x){x=String(x);if(!seen[x]){seen[x]=1;w.push(x);}});
  var want=DIFF<0.1?2:DIFF<0.45?3:4;
  w=(ordered?w:shuffle(r,w)).slice(0,Math.max(2,want));
  var opts=shuffle(r,[String(correct)].concat(w));
  return {k:'mc',q:q,opts:opts,a:opts.indexOf(String(correct))};
}
